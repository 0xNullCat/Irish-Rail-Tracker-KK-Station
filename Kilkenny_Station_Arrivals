#!/usr/bin/env python3
"""
Kilkenny Station Arrivals
Displays real-time train arrival information for Kilkenny station using Irish Rail API
"""

import argparse
import json
import sys
import time
import xml.etree.ElementTree as ET
from datetime import datetime
from typing import Dict, List, Optional

import requests


class Colour:
    """ANSI colour codes. Call Colour.disable() when colour is not wanted."""
    RESET  = '\033[0m'
    BOLD   = '\033[1m'
    RED    = '\033[91m'
    GREEN  = '\033[92m'
    YELLOW = '\033[93m'
    CYAN   = '\033[96m'

    @classmethod
    def disable(cls):
        for attr in ('RESET', 'BOLD', 'RED', 'GREEN', 'YELLOW', 'CYAN'):
            setattr(cls, attr, '')


class KilkennyStationTracker:
    def __init__(self):
        self.base_url = "http://api.irishrail.ie/realtime/realtime.asmx"

    def get_station_arrivals(self) -> List[Dict]:
        """Fetch current train arrivals at Kilkenny station."""
        try:
            url = f"{self.base_url}/getStationDataByNameXML"
            params = {
                'StationDesc': 'Kilkenny',
                'NumMins': '240',
            }

            response = requests.get(url, params=params, timeout=10)
            response.raise_for_status()

            root = ET.fromstring(response.content)
            ns = {'ir': 'http://api.irishrail.ie/realtime/'}

            arrivals = []
            for train in root.findall('ir:objStationData', ns):
                due_in_str = train.findtext('ir:Duein', '', ns)
                try:
                    due_in: Optional[int] = int(due_in_str)
                except (ValueError, TypeError):
                    due_in = None

                late_str = train.findtext('ir:Late', '0', ns)
                try:
                    late_mins: int = int(late_str)
                except (ValueError, TypeError):
                    late_mins = 0

                arrivals.append({
                    'train_code':          train.findtext('ir:Traincode', 'N/A', ns).strip(),
                    'origin':              train.findtext('ir:Origin', 'N/A', ns),
                    'destination':         train.findtext('ir:Destination', 'N/A', ns),
                    'scheduled_arrival':   train.findtext('ir:Scharrival', 'N/A', ns),
                    'expected_arrival':    train.findtext('ir:Exparrival', 'N/A', ns),
                    'scheduled_departure': train.findtext('ir:Schdepart', 'N/A', ns),
                    'expected_departure':  train.findtext('ir:Expdepart', 'N/A', ns),
                    'status':              train.findtext('ir:Status', 'N/A', ns),
                    'train_type':          train.findtext('ir:Traintype', 'N/A', ns),
                    'direction':           train.findtext('ir:Direction', 'N/A', ns),
                    'late_mins':           late_mins,
                    'due_in':              due_in,
                    'last_location':       train.findtext('ir:Lastlocation', 'N/A', ns),
                })

            return arrivals

        except requests.RequestException as e:
            print(f"Error fetching data: {e}", file=sys.stderr)
            return []
        except ET.ParseError as e:
            print(f"Error parsing XML: {e}", file=sys.stderr)
            return []

    def format_as_json(self, arrivals: List[Dict]) -> str:
        """Return arrivals serialised as a JSON string."""
        return json.dumps({
            'station': 'Kilkenny',
            'updated': datetime.now().isoformat(),
            'trains':  arrivals,
        }, indent=2)

    def display_arrivals(
        self,
        filter_origin: Optional[str] = None,
        filter_dest:   Optional[str] = None,
    ):
        """Display formatted arrival information."""
        C = Colour

        # Clear screen only when attached to a terminal (watch mode)
        if sys.stdout.isatty():
            print('\033[2J\033[H', end='')

        print("\n" + "=" * 80)
        print(f"{C.BOLD}{C.CYAN}"
              f"{'KILKENNY STATION - TRAIN ARRIVALS':^80}"
              f"{C.RESET}")
        print(f"{'Updated: ' + datetime.now().strftime('%Y-%m-%d %H:%M:%S'):^80}")
        print("=" * 80 + "\n")

        arrivals = self.get_station_arrivals()

        if not arrivals:
            print(f"{C.YELLOW}No arrivals found or unable to fetch data.{C.RESET}")
            print("\nNote: This uses the Irish Rail API. "
                  "Ensure you have internet connectivity.")
            return

        # Optional origin / destination filters
        if filter_origin:
            arrivals = [a for a in arrivals
                        if filter_origin.lower() in a['origin'].lower()]
        if filter_dest:
            arrivals = [a for a in arrivals
                        if filter_dest.lower() in a['destination'].lower()]

        if not arrivals:
            print(f"{C.YELLOW}No trains match the specified filter.{C.RESET}")
            return

        # Sort: soonest first, unknown/negative due_in last
        arrivals.sort(
            key=lambda x: x['due_in'] if x['due_in'] is not None else 9999
        )

        # Next-train summary banner
        upcoming = [a for a in arrivals
                    if a['due_in'] is not None and a['due_in'] >= 0]
        if upcoming:
            nxt  = upcoming[0]
            mins = nxt['due_in']
            c    = C.GREEN if mins > 10 else C.YELLOW if mins > 3 else C.RED
            print(f"{C.BOLD}Next train:{C.RESET} "
                  f"{nxt['train_code']} from {nxt['origin']} — "
                  f"{c}arriving in {mins} min{C.RESET}\n")

        for idx, train in enumerate(arrivals, 1):
            print(f"{C.BOLD}Train #{idx}{C.RESET}")
            print(f"  Train Code:    {C.BOLD}{train['train_code']}{C.RESET}")
            print(f"  From:          {train['origin']}")
            print(f"  To:            {train['destination']}")
            print(f"  Type:          {train['train_type']}")
            print(f"  Direction:     {train['direction']}")

            due_in = train['due_in']
            if due_in is not None:
                c = C.GREEN if due_in > 10 else C.YELLOW if due_in > 3 else C.RED
                print(f"  Due In:        {c}{due_in} minutes{C.RESET}")

            print(f"  Arrival:       {train['expected_arrival']} "
                  f"(scheduled: {train['scheduled_arrival']})")
            print(f"  Departure:     {train['expected_departure']} "
                  f"(scheduled: {train['scheduled_departure']})")

            late_mins = train['late_mins']
            if late_mins > 0:
                print(f"  Status:        {train['status']} — "
                      f"{C.RED}⚠️  DELAYED {late_mins} min(s){C.RESET}")
            else:
                print(f"  Status:        {train['status']} — "
                      f"{C.GREEN}✓ On time{C.RESET}")

            print(f"  Last Location: {train['last_location']}")
            print("-" * 80)

        print(f"\nTotal trains shown: {len(arrivals)}")
        print()


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Real-time train arrivals at Kilkenny Station",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "examples:\n"
            "  %(prog)s                      # one-shot display\n"
            "  %(prog)s --watch              # refresh every 60 s\n"
            "  %(prog)s --watch 120          # refresh every 120 s\n"
            "  %(prog)s --json               # JSON output\n"
            "  %(prog)s --from heuston       # filter by origin\n"
            "  %(prog)s --to waterford       # filter by destination\n"
            "  %(prog)s --no-colour          # disable colour output\n"
        ),
    )
    parser.add_argument(
        '--watch', '-w', nargs='?', const=60, type=int, metavar='SECONDS',
        help='continuously refresh every SECONDS (default: 60)',
    )
    parser.add_argument(
        '--json', action='store_true',
        help='output raw JSON instead of formatted text',
    )
    parser.add_argument(
        '--from', dest='filter_origin', metavar='STATION',
        help='only show trains whose origin contains STATION',
    )
    parser.add_argument(
        '--to', dest='filter_dest', metavar='STATION',
        help='only show trains whose destination contains STATION',
    )
    parser.add_argument(
        '--no-colour', '--no-color', action='store_true',
        help='disable ANSI colour output',
    )
    return parser.parse_args()


def main():
    args = parse_args()

    if args.no_colour or not sys.stdout.isatty():
        Colour.disable()

    tracker = KilkennyStationTracker()

    if args.json:
        arrivals = tracker.get_station_arrivals()
        print(tracker.format_as_json(arrivals))
        return

    if args.watch is not None:
        interval = args.watch
        print(f"Watching Kilkenny Station arrivals "
              f"(refreshing every {interval}s). Press Ctrl+C to stop.\n")
        try:
            while True:
                tracker.display_arrivals(
                    filter_origin=args.filter_origin,
                    filter_dest=args.filter_dest,
                )
                time.sleep(interval)
        except KeyboardInterrupt:
            print("\nStopped.")
    else:
        tracker.display_arrivals(
            filter_origin=args.filter_origin,
            filter_dest=args.filter_dest,
        )


if __name__ == "__main__":
    main()
